@startuml
title Diagrama de Caso de Uso - Barbosa Control

left to right direction

actor "Administrador / Dono" as Admin
actor "Vendedor" as Vendedor
actor "Sistema Asaas" as Asaas

rectangle "Barbosa Control" {

  usecase "UC-01\nCadastrar Cliente" as UC01
  usecase "UC-02\nCadastrar Produto" as UC02
  usecase "UC-03\nConsultar Estoque" as UC03
  usecase "UC-04\nRegistrar Venda à Vista" as UC04
  usecase "UC-05\nRegistrar Venda Fiada" as UC05
  usecase "UC-06\nVerificar Situação do Cliente" as UC06
  usecase "UC-07\nGerar Conta a Receber" as UC07
  usecase "UC-08\nRegistrar Pagamento / AV" as UC08
  usecase "UC-09\nAtualizar Saldo Devedor" as UC09
  usecase "UC-10\nConsultar Contas Vencidas" as UC10
  usecase "UC-11\nRegistrar Cobrança via Asaas" as UC11
  usecase "UC-12\nGerar Relatório Financeiro" as UC12
  usecase "UC-13\nGerenciar Usuários" as UC13
  usecase "UC-14\nAtualizar Estoque" as UC14
}

Admin --> UC01
Admin --> UC02
Admin --> UC03
Admin --> UC04
Admin --> UC05
Admin --> UC08
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13

Vendedor --> UC01
Vendedor --> UC03
Vendedor --> UC04
Vendedor --> UC05
Vendedor --> UC08

Asaas --> UC11

UC04 ..> UC14 : <<include>>
UC05 ..> UC06 : <<include>>
UC05 ..> UC07 : <<include>>
UC05 ..> UC14 : <<include>>
UC08 ..> UC09 : <<include>>

@enduml
